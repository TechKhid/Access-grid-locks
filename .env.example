# Visit notifications (see api/track.js).
# Set these in Vercel → Project → Settings → Environment Variables.
# For local testing, copy this file to .env.local and fill it in.

# The ntfy topic you subscribe to in the ntfy app. Treat it like a password:
# anyone who knows the name can read it. Use something long and random.
NTFY_TOPIC=

# Optional: your own ntfy server (default is https://ntfy.sh)
# NTFY_SERVER=

# Optional: access token, if the topic is protected
# NTFY_TOKEN=
